# Copy this file to .env for local testing.
# On Render/Railway/Vercel, set these same values in the dashboard's Environment Variables section instead of using this file.

# Get this from https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

# Optional: override which Claude model is used. Leave as-is unless Anthropic tells you this model is retired.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Get this from https://dashboard.stripe.com  (Developers -> API Keys). Use the SECRET key, not the publishable key.
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# Price in whole US dollars for a 20-credit pack. Change this any time without touching code.
CREDIT_PACK_PRICE_USD=9
CREDIT_PACK_CREDITS=20

# How many free generations a visitor gets per day before being asked to buy credits
FREE_DAILY_GENERATIONS=2

# The full public URL this app will be deployed at (no trailing slash). Needed so Stripe knows where to send people back to.
# Example: https://resumefit.onrender.com   or your own domain like https://resumefit.com
PUBLIC_URL=http://localhost:3000

# Port the server listens on locally. Render/Railway set this automatically in production.
PORT=3000
